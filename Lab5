# Programma 4

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity extRAM is
  port(
    clock   : in  std_logic;
    wren    : in  std_logic;
    address : in  std_logic_vector(7 downto 0);  -- 256 θέσεις
    data_in : in  std_logic_vector(7 downto 0);
    data_out: out std_logic_vector(7 downto 0)
  );
end entity;

architecture rtl of extRAM is
  type ram_t is array(0 to 255) of std_logic_vector(7 downto 0);
  signal ram : ram_t := (others => (others => '0'));
begin
  -- Ασύγχρονη ανάγνωση (εύκολο σε waveform simulation)
  data_out <= ram(to_integer(unsigned(address)));

  process(clock)
  begin
    if rising_edge(clock) then
      if wren = '1' then
        ram(to_integer(unsigned(address))) <= data_in;
      end if;
    end if;
  end process;

  -- ΣΗΜΕΙΩΣΗ:
  -- Για initialization από extRAM.mif σε Quartus:
  -- 1) φτιάχνεις RAM:1-PORT με lpm_file="extRAM.mif"
  -- 2) ή κάνεις Memory Initialization στο project.
end architecture;

